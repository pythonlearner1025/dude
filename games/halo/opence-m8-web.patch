+	previous = now;
+	if (now - period_start >= 2000.0 && count)
+	{
+		double elapsed = now - period_start;
+		double longest;
+		unsigned long p50, p95, p99;
+
+		qsort(times, count, sizeof(times[0]), compare_frame_time);
+		p50 = (count * 50 + 99) / 100 - 1;
+		p95 = (count * 95 + 99) / 100 - 1;
+		p99 = (count * 99 + 99) / 100 - 1;
+		longest = times[count - 1];
+		fprintf(stderr,
+			"halo-perf: %.2f fps, frame ms p50 %.2f p95 %.2f p99 %.2f, longest %.2f (%lu frames)\n",
+			(double)count * 1000.0 / elapsed, times[p50], times[p95], times[p99], longest, count);
+		count = 0;
+		period_start = now;
+	}
+}
