new file mode 100755
index 00000000..6602d0f5
--- /dev/null
+++ b/tools/make_maps_manifest.py
@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+"""Write maps/manifest.json for a maps folder beside this script."""
+
+import argparse
+import json
+import os
+import tempfile
+from pathlib import Path
+
+
+def make_manifest(maps: Path) -> Path:
+    entries = [
+        {"name": path.name, "size": path.stat().st_size}
+        for path in sorted(maps.iterdir(), key=lambda path: path.name.lower())
+        if path.is_file() and (path.suffix.lower() == ".map" or path.name.lower() == "loading.tga")
+    ]
+    destination = maps / "manifest.json"
+    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=maps, delete=False) as output:
+        json.dump(entries, output, separators=(",", ":"))
+        output.write("\n")
+        temporary = Path(output.name)
+    os.replace(temporary, destination)
+    return destination
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("maps", nargs="?", type=Path, default=Path(__file__).resolve().parent / "maps")
+    args = parser.parse_args()
+    destination = make_manifest(args.maps.resolve())
+    print(f"Wrote {destination}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
