+static real companion_facing_degrees(
+	real_vector3d const *forward)
+{
+	real degrees = RADIANS_TO_DEGREES((real)atan2(forward->j, forward->i));
+
+	return degrees < 0.f ? degrees + 360.f : degrees;
+}
+
+static real companion_relative_bearing(
+	real_point3d const *player,
+	real_vector3d const *facing,
+	real_point3d const *point)
+{
+	real bearing = RADIANS_TO_DEGREES((real)atan2(facing->j, facing->i) -
+		(real)atan2(point->y - player->y, point->x - player->x));
+
+	while (bearing > 180.f)
+		bearing -= 360.f;
+	while (bearing < -180.f)
+		bearing += 360.f;
+	return bearing;
+}
+
+static char const *companion_relative_words(
+	real bearing)
+{
+	real absolute = (real)fabs(bearing);
+
+	if (absolute <= 15.f)
+		return "ahead of you";
+	if (absolute <= 60.f)
+		return bearing > 0.f ? "ahead of you, slightly to the right" : "ahead of you, slightly to the left";
+	if (absolute <= 120.f)
+		return bearing > 0.f ? "to your right" : "to your left";
+	if (absolute <= 165.f)
+		return bearing > 0.f ? "behind you, slightly to the right" : "behind you, slightly to the left";
+	return "behind you";
+}
+
+static char const *companion_activity(
+	void)
+{
+	switch (companion_body.order)
+	{
+	case _companion_order_follow: return "following";
+	case _companion_order_attack: return "attacking";
+	case _companion_order_advance: return "rushing";
+	case _companion_order_cover: return "cover";
+	case _companion_order_retreat: return "falling_back";
+	case _companion_order_pick_up: return "going_to_weapon";
+	case _companion_order_get_in: return "going_to_vehicle";
+	default: return "holding";
+	}
+}
+
+static char const *companion_seat_name(
+	struct unit_datum const *unit)
+{
+	struct unit_definition *definition;
+	struct unit_seat *seat;
+
+	if (unit->object.parent_object_index == NONE || unit->unit.parent_seat_index == NONE)
+		return NULL;
+	definition = unit_definition_get(unit_get(unit->object.parent_object_index)->definition_index);
+	seat = TAG_BLOCK_GET_ELEMENT(&definition->unit.seats, unit->unit.parent_seat_index, struct unit_seat);
+	if (TEST_FLAG(seat->flags, _unit_seat_driver_bit))
+		return "driver";
+	if (TEST_FLAG(seat->flags, _unit_seat_gunner_bit))
+		return "gunner";
+	return "passenger";
+}
+
+/* an object's id only when it is one of the current action options */
+static long companion_option_id(
+	long object_index)
+{
+	short index;
+
+	for (index = 0; index < companion_enemy_count; index++)
+	{
+		if (companion_enemies[index].unit_index == object_index)
+			return object_index & 0xFFFF;
+	}
+	for (index = 0; index < companion_weapon_count; index++)
+	{
+		if (companion_weapons[index].object_index == object_index)
+			return object_index & 0xFFFF;
+	}
+	for (index = 0; index < companion_vehicle_count; index++)
+	{
+		if (companion_vehicles[index].object_index == object_index)
+			return object_index & 0xFFFF;
+	}
+	return NONE;
+}
+
+static void companion_vehicle_json(
+	struct unit_datum const *unit,
+	char *json,
+	int size)
+{
+	char const *seat = companion_seat_name(unit);
+
+	if (!seat)
+	{
+		snprintf(json, size, "null");
+		return;
+	}
+	snprintf(json, size, "{\"name\":\"%s\",\"seat\":\"%s\"}",
+		companion_unit_kind(unit->object.parent_object_index), seat);
+}
+
+static boolean companion_player_aim(
+	real_point3d *point,
+	char const **label,
+	long *id,
+	real *distance)
+{
+	struct render_camera camera;
+	struct render_frustum frustum;
+	real_vector3d along;
+	struct collision_result collision;
+	long object_index;
+
+	if (!companion_view_camera(&camera, &frustum))
+		return FALSE;
+	along = camera.forward;
+	normalize3d(&along);
+	scale_vector3d(&along, COMPANION_VIEW_REACH, &along);
+	if (!collision_test_vector(FLAG(_collision_test_structure_bit) | FLAG(_collision_test_front_facing_surfaces_bit) |
+			FLAG(_collision_test_objects_bit) | _collision_test_objects_all_types_flags,
+			&camera.position, &along, companion_player_unit(), &collision))
+	{
+		return FALSE;
+	}
+	*point = collision.point;
+	*distance = distance3d(&camera.position, point) * COMPANION_METRES_PER_UNIT;
+	*id = NONE;
+	if (collision.type != _collision_result_object)
+	{
+		*label = collision.plane.n.k >= 0.6f ? "ground" : "wall";
+		return TRUE;
+	}
+	object_index = collision.object_index;
+	*id = companion_option_id(object_index);
+	if (*id == NONE)
+	{
+		long parent_index = object_get_ultimate_parent(object_index);
+
+		if (parent_index != object_index && companion_option_id(parent_index) != NONE)
+		{
+			object_index = parent_index;
+			*id = companion_option_id(object_index);
+		}
+	}
+	*label = companion_unit_kind(object_index);
+	return TRUE;
+}
+
+static void companion_target_json(
+	long player_unit_index,
+	char *json,
+	int size)
+{
+	struct companion_enemy const *target = companion_current_target();
+	real_point3d point;
+	char const *kind;
+	char const *label;
+	long object_index;
+	long id;
+
+	if (target)
+	{
+		if (target->unit_index == player_unit_index)
+		{
+			object_get_origin(player_unit_index, &point);
+			kind = "player";
+			label = "Chief";
+			id = NONE;
+		}
+		else
+		{
+			point = target->aim_point;
+			kind = object_get(target->unit_index)->object.type == _object_type_vehicle ? "vehicle" : "unit";
+			label = companion_unit_kind(target->unit_index);
+			id = target->unit_index & 0xFFFF;
+		}
+	}
+	else if (companion_body.order == _companion_order_pick_up || companion_body.order == _companion_order_get_in)
+	{
+		object_index = companion_body.goal_object_index;
+		point = object_get(object_index)->object.bounding_sphere_center;
+		kind = companion_body.order == _companion_order_pick_up ? "weapon" : "vehicle";
+		label = companion_unit_kind(object_index);
+		id = object_index & 0xFFFF;
+	}
+	else if (companion_body.point_target)
+	{
+		point = companion_body.hold_point;
+		kind = "point";
+		label = "chosen point";
+		id = NONE;
+	}
+	else if (companion_body.order == _companion_order_follow)
+	{
+		object_get_origin(player_unit_index, &point);
+		kind = "player";
+		label = "Chief";
+		id = NONE;
+	}
+	else
+	{
+		snprintf(json, size, "null");
+		return;
+	}
+	if (id == NONE)
+	{
+		snprintf(json, size,
+			"{\"kind\":\"%s\",\"id\":null,\"label\":\"%s\",\"pos\":[%.2f,%.2f,%.2f]}",
+			kind, label, point.x * COMPANION_METRES_PER_UNIT, point.y * COMPANION_METRES_PER_UNIT,
+			point.z * COMPANION_METRES_PER_UNIT);
+	}
+	else
+	{
+		snprintf(json, size,
+			"{\"kind\":\"%s\",\"id\":\"%ld\",\"label\":\"%s\",\"pos\":[%.2f,%.2f,%.2f]}",
+			kind, id, label, point.x * COMPANION_METRES_PER_UNIT, point.y * COMPANION_METRES_PER_UNIT,
+			point.z * COMPANION_METRES_PER_UNIT);
+	}
+}
