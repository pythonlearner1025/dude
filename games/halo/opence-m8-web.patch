+/* the other, remote co-op player's living unit (Kevin is player 2) */
+static long companion_coop_unit(
+	void)
+{
+	struct data_iterator iterator;
+	struct player_datum *player;
+	long local_player_index = local_player_get_player_index(0);
+
+	data_iterator_new(&iterator, player_data);
+	while ((player = (struct player_datum *)data_iterator_next(&iterator)) != NULL)
+	{
+		if (iterator.datum_index != local_player_index && !player->quit_out_of_game)
+			return distributed_living_unit(player);
+	}
+	return NONE;
+}
