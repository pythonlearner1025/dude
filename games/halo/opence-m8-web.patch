diff --git a/port/web/site/app.js b/port/web/site/app.js
index 860b5869..2ce7f93b 100644
--- a/port/web/site/app.js
+++ b/port/web/site/app.js
@@ -33,6 +33,164 @@ const params = new URLSearchParams(location.search);
 const WEB_MEMORY_BYTES = 0x88000000;
 const MAXIMUM_LOG_LINES = 20000;
 
+// ---------- m8 companion and page microphone
+
+const M8_URL_KEY = 'halo-m8-url';
+const MIC_URL_KEY = 'halo-mic-url';
+
+function stored(key, fallback) {
+  try { return localStorage.getItem(key) || fallback; } catch { return fallback; }
+}
+
+function micFromM8(value) {
+  try {
+    const url = new URL(value);
+    url.pathname = '/mic';
+    url.search = '';
+    url.hash = '';
+    return url.href;
+  } catch {
+    return 'ws://127.0.0.1:8091/mic';
+  }
+}
+
+let m8URL = params.get('m8') || stored(M8_URL_KEY, 'ws://127.0.0.1:8091/game');
+let micURL = params.get('mic') || stored(MIC_URL_KEY, micFromM8(m8URL));
+$('m8-url').value = m8URL;
+$('mic-url').value = micURL;
+
+function saveLinkInputs(m8Changed) {
+  m8URL = $('m8-url').value.trim();
+  if (m8Changed && !params.has('mic')) $('mic-url').value = micFromM8(m8URL);
+  micURL = $('mic-url').value.trim();
+  try {
+    localStorage.setItem(M8_URL_KEY, m8URL);
+    localStorage.setItem(MIC_URL_KEY, micURL);
+  } catch {
+    // private storage may be disabled
+  }
+  if (game && game.haloSetM8URL) game.haloSetM8URL(m8URL);
+}
+
+$('m8-url').addEventListener('change', () => saveLinkInputs(true));
+$('mic-url').addEventListener('change', () => saveLinkInputs(false));
+
+let micEnabled = false;
+let micSocket = null;
+let micReconnect = 0;
+let micStream = null;
+let micContext = null;
+let micProcessor = null;
+let micPosition = 0;
+let micLastSample = 0;
+let micFrame = [];
+let micStarting = false;
+
+function setMicStatus(text) { $('mic-status').textContent = text; }
+
+function connectMic() {
+  clearTimeout(micReconnect);
+  if (!micEnabled) return;
+  let socket;
+  try { socket = new WebSocket(micURL); } catch {
+    setMicStatus('Invalid address');
+    micReconnect = setTimeout(connectMic, 2000);
+    return;
+  }
+  micSocket = socket;
+  socket.binaryType = 'arraybuffer';
+  setMicStatus('Connecting…');
+  socket.onopen = () => setMicStatus('Connected');
+  socket.onclose = () => {
+    if (micSocket === socket) micSocket = null;
+    if (micEnabled) {
+      setMicStatus('Reconnecting…');
+      micReconnect = setTimeout(connectMic, 2000);
+    }
+  };
+  socket.onerror = () => socket.close();
+}
+
+function sendMicInput(input, rate) {
+  let sum = 0;
+  for (let i = 0; i < input.length; i++) sum += input[i] * input[i];
+  $('mic-level').value = Math.min(1, Math.sqrt(sum / Math.max(1, input.length)) * 5);
+  const source = new Float32Array(input.length + 1);
+  source[0] = micLastSample;
+  source.set(input, 1);
+  const step = rate / 16000;
+  let position = micPosition;
+  while (position < input.length) {
+    const at = Math.floor(position);
+    const part = position - at;
+    const sample = source[at] + (source[at + 1] - source[at]) * part;
+    micFrame.push(Math.max(-32768, Math.min(32767, Math.round(sample * 32767))));
+    if (micFrame.length === 320) {
+      if (micSocket && micSocket.readyState === WebSocket.OPEN) {
+        micSocket.send(new Int16Array(micFrame).buffer);
+      }
+      micFrame = [];
+    }
+    position += step;
+  }
+  micPosition = position - input.length;
+  micLastSample = input[input.length - 1] || micLastSample;
+}
+
+async function startMic() {
+  if (micEnabled || micStarting) return;
+  micStarting = true;
+  $('mic-toggle').disabled = true;
+  saveLinkInputs(false);
+  try {
+    micStream = await navigator.mediaDevices.getUserMedia({ audio: {
+      echoCancellation: true, noiseSuppression: true, autoGainControl: true,
+      channelCount: 1,
+    } });
+    micContext = new AudioContext();
+    await micContext.resume();
+    const source = micContext.createMediaStreamSource(micStream);
+    micProcessor = micContext.createScriptProcessor(2048, 1, 1);
+    const silent = micContext.createGain();
+    silent.gain.value = 0;
+    micProcessor.onaudioprocess = (event) => sendMicInput(event.inputBuffer.getChannelData(0), micContext.sampleRate);
+    source.connect(micProcessor);
+    micProcessor.connect(silent).connect(micContext.destination);
+    micEnabled = true;
+    $('mic-toggle').textContent = 'Turn microphone off';
+    connectMic();
+  } catch (error) {
+    setMicStatus('Unavailable: ' + (error.message || error));
+  } finally {
+    micStarting = false;
+    $('mic-toggle').disabled = false;
+  }
+}
+
+async function stopMic() {
+  micEnabled = false;
+  clearTimeout(micReconnect);
+  if (micSocket) micSocket.close();
+  if (micStream) for (const track of micStream.getTracks()) track.stop();
+  if (micContext) await micContext.close();
+  micSocket = micStream = micContext = micProcessor = null;
+  micFrame = [];
+  $('mic-level').value = 0;
+  $('mic-toggle').textContent = 'Turn microphone on';
+  setMicStatus('Off');
+}
+
+$('mic-toggle').addEventListener('click', () => micEnabled ? stopMic() : startMic());
+
+async function startGrantedMic() {
+  if (!navigator.permissions || !navigator.permissions.query) return;
+  try {
+    if ((await navigator.permissions.query({ name: 'microphone' })).state === 'granted') await startMic();
+  } catch {
+    // unsupported permission name: leave the button for the player
+  }
+}
+
