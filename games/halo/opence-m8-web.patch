+    micProcessor = micContext.createScriptProcessor(2048, 1, 1);
+    const silent = micContext.createGain();
+    silent.gain.value = 0;
+    micProcessor.onaudioprocess = (event) => sendMicInput(event.inputBuffer.getChannelData(0), micContext.sampleRate);
+    source.connect(micProcessor);
+    micProcessor.connect(silent).connect(micContext.destination);
+    micEnabled = true;
+    $('mic-toggle').textContent = 'Turn microphone off';
+    connectMic();
+  } catch (error) {
+    setMicStatus('Unavailable: ' + (error.message || error));
+  } finally {
+    micStarting = false;
+    $('mic-toggle').disabled = false;
+  }
+}
+
+async function stopMic() {
+  micEnabled = false;
+  clearTimeout(micReconnect);
+  if (micSocket) micSocket.close();
+  if (micStream) for (const track of micStream.getTracks()) track.stop();
+  if (micContext) await micContext.close();
+  micSocket = micStream = micContext = micProcessor = null;
+  micFrame = [];
+  $('mic-level').value = 0;
+  $('mic-toggle').textContent = 'Turn microphone on';
+  setMicStatus('Off');
+}
+
+$('mic-toggle').addEventListener('click', () => micEnabled ? stopMic() : startMic());
+
+async function startGrantedMic() {
+  if (!navigator.permissions || !navigator.permissions.query) return;
+  try {
+    if ((await navigator.permissions.query({ name: 'microphone' })).state === 'granted') await startMic();
+  } catch {
+    // unsupported permission name: leave the button for the player
+  }
